{
    "name": "@marketsdk/js",
    "version": "1.0.0",
    "private": false,
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.mts",
                "default": "./dist/esm/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            },
            "default": "./dist/cjs/index.js"
        },
        "./marketplace": {
            "import": {
                "types": "./dist/esm/api/resources/marketplace/exports.d.mts",
                "default": "./dist/esm/api/resources/marketplace/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/marketplace/exports.d.ts",
                "default": "./dist/cjs/api/resources/marketplace/exports.js"
            },
            "default": "./dist/cjs/api/resources/marketplace/exports.js"
        },
        "./sellers": {
